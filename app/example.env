# All values are optional and only used on the very first start to create data/config.json.
# After that, everything is configured in the web UI (http://SERVER_IP:8000/ui/).
# Keep comments on their own line (not all docker versions strip inline comments).

# Hue Bridge API key (or use "Pair new key" in the UI)
apikey=
# IP address of the Hue Bridge
ip=
# IP addresses / CIDR networks, comma separated, or * for all
allowed_hosts=*
# Initial admin password (min. 10 chars). If empty, a random one is printed to `docker compose logs`.
admin_password=
# Set to true when serving the UI via an HTTPS reverse proxy
cookie_secure=false
